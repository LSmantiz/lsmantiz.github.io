@article{calegari_heterogeneous_2023,
	title = {The heterogeneous effect of {European} {Union} {Cohesion} {Policy} on regional well-being},
	volume = {30},
	issn = {0969-7764, 1461-7145},
	url = {http://journals.sagepub.com/doi/10.1177/09697764231188304},
	doi = {10.1177/09697764231188304},
	abstract = {This study contributes to understanding the multidimensional effects of the European Union Cohesion Policy and highlights the importance of considering a wider range of well-being indicators when evaluating regional policies. The Extended Regional Development Index is an index of regional well-being that measures a broader set of regional outcomes. We examine the effects of Cohesion Policy on the Extended Regional Development Index in European Union-27 regions from 2007 to 2013, analysing the distributional effects on different quantiles of the index. Our findings highlight the Cohesion Policy’s role in supporting regional well-being and individual income levels during the double recession of 2008 and 2011. Moreover, the policy contributes to a process of convergence between regions, especially in light of increased disparities due to the European Union’s eastern enlargement.},
	language = {en},
	number = {4},
	urldate = {2024-04-15},
	journal = {European Urban and Regional Studies},
	author = {Calegari, Elena and Ferrara, Antonella Rita and Freo, Marzia and Reggiani, Aura},
	month = oct,
